{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitsu",
  "version": "1.2.0",
  "identifier": "app.mitsu.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:* https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Entertainment",
    "shortDescription": "Local-first manga library and reader",
    "longDescription": "Mitsu keeps your manga library on your own machine. Import CBZ and ZIP archives or image folders, read with saved progress, and organize your collection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Chandu4143/mitsu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENkEyOURDRkFDRDJFMEQKUldRTkxzMzYzQ2xxN2F0ZU1oMHBOQlhFT1VwbE0vK0h1MUVZNmVTeEMrK0JEbS9VTWNYYnh2ZmkK"
    }
  }
}
