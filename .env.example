# Mitsu backend configuration.
#
# Copy this file to backend/.env or export the values in your shell.
# Every value has a sensible default — an empty config works fine for a
# single-user, local-first setup. Nothing here is required to run.

# --- Paths -------------------------------------------------------------
# Where the SQLite database, thumbnails and cache live. Defaults to
# <repo>/data. Thumbnails are derived data and can be safely deleted.
#MITSU_DATA_DIR=

# Where imported galleries are stored. Defaults to
# <MITSU_DATA_DIR>/library. Importing does not move your original files;
# it copies them in. Point this elsewhere only if you want a different
# storage location for imported copies.
#MITSU_LIBRARY_ROOT=

# --- Server ------------------------------------------------------------
# Backend bind address and port (used by `python -m uvicorn` from the
# backend directory and by run.py's backend process).
#MITSU_HOST=127.0.0.1
#MITSU_PORT=8000

# Allowed CORS origin for the frontend.
#MITSU_FRONTEND_ORIGIN=http://localhost:3000

# --- Import safety limits ---------------------------------------------
# Guards against oversized or hostile archives. Raise only if you have
# very large CBZ files.
#MITSU_MAX_ARCHIVE_BYTES=4294967296        # 4 GiB per archive
#MITSU_MAX_EXTRACTED_BYTES=8589934592      # 8 GiB after extraction
#MITSU_MAX_ARCHIVE_ENTRIES=20000           # files per archive
#MITSU_MAX_IMAGE_PIXELS=80000000           # 80 MP decompression bomb limit
